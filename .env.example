# =============================================================================
# Farmer's Dairy — environment variables
# =============================================================================
#
# Vercel: set each of these under Project → Settings → Environment Variables.
# Local dev: copy this file to .env.local and fill in the values.
#
# NEVER commit real secrets. .env / .env.local are git-ignored.
# =============================================================================

# --- Supabase (server, service role — bypasses RLS) ---
# One of these must be set. The service_role key from
# https://supabase.com/dashboard/project/<project>/settings/api
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Legacy alias — kept as a fallback for older deployments
# SUPABASE_SERVICE_API_KEY=your-service-role-key

# --- Supabase (client-safe, anon public) ---
# Used by the browser. VITE_* is the one the Vite build reads.
# The NEXT_PUBLIC_* alias lets you reuse the same value from the old Next.js
# project without renaming.
VITE_SUPABASE_URL=https://ddcungvetvmbikwfvytq.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Razorpay ---
# Server (secret, never exposed)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
# Client — public key id, opens the checkout modal
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# --- Resend (contact form email) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where contact-form submissions are delivered
CONTACT_EMAIL_TO=onprimehub@gmail.com

# --- Admin dashboard ---
# Anyone with this passphrase can view /admin. Change from the default.
ADMIN_PASSPHRASE=change-me-in-production
